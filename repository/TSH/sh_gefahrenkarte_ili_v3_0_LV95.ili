    END Fliessgeschwindigkeit_100;

    CLASS Fliessgeschwindigkeit_300 =
      Geometrie : MANDATORY Naturgefahrenkarte_Kt_SH_LV95_V3_0.Einzelflaeche;
      Fliessgeschwindigkeit : MANDATORY Naturgefahrenkarte_Kt_SH_LV95_V3_0.Fliessgeschwindigkeit_Typ;
      ID_Gefahrenquelle : MANDATORY TEXT*100;
       /**Erfassungsbuero
      */
