    CLASS Fliesstiefe_skaliert_30 =
      Geometrie : MANDATORY Naturgefahrenkarte_Kt_SH_LV95_V3_0.Einzelflaeche;
      Fliesstiefe : MANDATORY Naturgefahrenkarte_Kt_SH_LV95_V3_0.Fliesstiefe_Typ;
      ID_Gefahrenquelle : MANDATORY TEXT*100;
       /**Erfassungsbuero
      */
