MODEL Risikokarte_LV95_V1_0 (de)
AT "http://geo.sh.ch" VERSION "2018-05-3"  =
  IMPORTS GeometryCHLV95_V1;
  TOPIC Risikokarte =
	DOMAIN
	RisikonutzungsTyp = (
		gering,
		mittel,
		hoch,
		sehr_hoch
	);
	CLASS Risikokarte =
	
	  Risiko: RisikonutzungsTyp;
	  Standorteigenschaft: TEXT*20;
	  Bemerkungen: TEXT;
	  Geometry: GeometryCHLV95_V1.SurfaceWithOverlaps2mm;
	  
	  
      
    END Risikokarte;

  END Risikokarte;

END Risikokarte_LV95_V1_0.