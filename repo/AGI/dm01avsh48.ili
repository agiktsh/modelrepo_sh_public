    TABLE ProjObjektnummerPos_UeP5 =
      ProjObjektnummerPos_UeP5_von: -> ProjObjektnummer;  !! Beziehung 1-mc;
                                                          !! beschriftet Nummer
      Pos: LKoord;
      Ori: Rotation;
      HAli: OPTIONAL HALIGNMENT // undefiniert = Center //;
      VAli: OPTIONAL VALIGNMENT // undefiniert = Half //;
