!!@ technicalContact=mailto:gis@sh.ch
!!@ furtherInformation=https://geo.sh.ch
!!@ tags="Kanton Schaffhausen, Abfallanlagen, Materialentnahmestellen, Deponien, Ablagerungsstandorte, KVA, Kehrichtverwertungsanlagen"

MODEL SH_Abfallanlagen_MatEntnahmestellen_V1_0 (de)
AT "http://geo.sh.ch"
VERSION "2023-03-17" =

  IMPORTS Abfallanlagen_MatEntnahmestellen_V1_2;

  TOPIC Anlagen EXTENDS Abfallanlagen_MatEntnahmestellen_V1_2.Anlagen =
	OID AS INTERLIS.UUIDOID;  !! Erweiterung des MGDM-TOPIC um OID-Deklaration

	CLASS Anlage (EXTENDED) =
		/** Zwingende Angabe */
		Auffuellpflicht : MANDATORY BOOLEAN;
		/** Optional */
		Bemerkung : MTEXT;
	END Anlage;
	
  END Anlagen;

END SH_Abfallanlagen_MatEntnahmestellen_V1_0.