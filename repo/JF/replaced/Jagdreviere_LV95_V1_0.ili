MODEL Jagdreviere_LV95_V1_0 (de)
AT "http://geo.sh.ch"
VERSION "2020-04-02"  =
  IMPORTS Units, GeometryCHLV95_V1;

  TOPIC Jagdreviere =

    CLASS Jagdrevier =
		Geometrie : MANDATORY GeometryCHLV95_V1.Surface;
		Name : MANDATORY TEXT*100;
		Listennummer : MANDATORY TEXT*100;
    END Jagdrevier;

    CLASS Schonrevier =
		Geometrie : MANDATORY GeometryCHLV95_V1.Surface;
		Name : MANDATORY TEXT*100;
		Listennummer : MANDATORY TEXT*100;
    END Schonrevier;

    CLASS Siedlungsflaeche =
		Geometrie : MANDATORY GeometryCHLV95_V1.Surface;
		Gemeinde : MANDATORY TEXT*100;
    END Siedlungsflaeche;

    CLASS Naturschutzgebiet =
		Geometrie : MANDATORY GeometryCHLV95_V1.Surface;
		Name : MANDATORY TEXT*100;
    END Naturschutzgebiet;

    CLASS Nichtjagdbare_Zone =
		Geometrie : MANDATORY GeometryCHLV95_V1.Surface;
		Name : MANDATORY TEXT*100;
    END Nichtjagdbare_Zone;

  END Jagdreviere;

END Jagdreviere_LV95_V1_0.
